# OriginTracer Agent Server
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_ASSISTANT_ID=origintracer_investigator

# Optional Next.js path prefix for deployments mounted below a domain path.
# Leave empty for local development; for example, set /chat-agent for production.
NEXT_BASE_PATH=

# Server-side Agent Server URL, proxied through this app to avoid browser CORS issues.
LANGGRAPH_API_URL=http://127.0.0.1:8123
NEXT_PUBLIC_AGENT_SERVER_LABEL=127.0.0.1:8123
NEXT_PUBLIC_AGENT_API_DOCS_URL=http://127.0.0.1:8123/docs
NEXT_PUBLIC_BACKEND_API_DOCS_URL=http://127.0.0.1:8123/docs

# Keycloak OIDC. Leave blank to use the local development API key flow.
# In production, set AUTH_SECRET to a long random value and configure a
# confidential Keycloak client with this app's callback URL.
AUTH_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/origintracer
AUTH_KEYCLOAK_ID=origintracer-chat
AUTH_KEYCLOAK_SECRET=

# OriginTracer backend used by the small server-side worker inventory route.
ORIGINTRACER_API_URL=http://127.0.0.1:8001
ORIGINTRACER_API_KEY=test-key-123

# For a path-mounted production deployment, also set NEXT_PUBLIC_API_URL to the
# public proxy URL including that prefix, e.g. https://example.com/chat-agent/api.
