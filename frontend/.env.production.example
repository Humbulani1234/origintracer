# Vite public path. This value is baked into the static build.
VITE_BASE_PATH=/chat-react/

# Same-origin Nginx proxy to FastAPI. Strip /origintracer-api/ and forward
# the browser Authorization header; do not inject a shared production API key.
VITE_API_URL=/origintracer-api

# Leave empty in production; never put a real backend key in a browser bundle.
VITE_API_KEY=

# Keycloak OIDC client (browser client must be public with PKCE enabled).
VITE_OIDC_AUTHORITY=https://identity.example.com/realms/origintracer
VITE_OIDC_CLIENT_ID=origintracer-dashboard
# Optional; defaults to this site's callback URL. Register both callback URLs
# on the Keycloak client.
# VITE_OIDC_REDIRECT_URI=https://origintracer.app/chat-react/auth/callback
