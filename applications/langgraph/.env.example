# Agent Server may require credentials for the selected deployment mode.
# This key is for Agent Server access; LangSmith tracing remains disabled.
LANGSMITH_API_KEY=your-agent-server-key
LANGSMITH_TRACING=false

# Select a tool-calling model already pulled into Ollama.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional OriginTracer backend for event upload.
ORIGINTRACER_ENDPOINT=http://host.docker.internal:8001

# Prompt and tool content capture are disabled by default.
# Enable only when you are allowed to inspect that content.
# ORIGINTRACER_CAPTURE_LLM_CONTENT=1
# ORIGINTRACER_CAPTURE_TOOL_CONTENT=1
